# Copy to .env.local and fill in. Mirror these in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Long random string; /api/refresh requires "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional: canonical URL for metadata/OG tags (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically).
# NEXT_PUBLIC_SITE_URL=https://your-url.vercel.app
# Backup AQI source, not wired in v1.
# WAQI_TOKEN=
